{
  "expo": {
    "name": "IronLog",
    "slug": "ironlog",
    "owner": "jonaswahlerts-team",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ironlog",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "se.jonaswahlert.ironlog",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "IronLog använder kameran för att fotografera maskiner och vikter.",
        "NSPhotoLibraryUsageDescription": "IronLog läser bilder från ditt bibliotek.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0d13",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "IronLog läser bilder från ditt bibliotek.",
          "cameraPermission": "IronLog använder kameran för att fotografera maskiner, vikter och profil-/progressbilder."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a076a0b7-9787-40f8-b438-818bcdaa471e"
      }
    }
  }
}
